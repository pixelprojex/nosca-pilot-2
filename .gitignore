node_modules/
dist/
.env
.env.*
!.env.example
.DS_Store
# Not committed on purpose: package.json is edited by hand and uploaded,
# and a lockfile that falls out of step with it makes Netlify's npm ci fail.
package-lock.json

# agent worktrees and local harness state
.claude/
.e2e-out/

# Mock-Supabase bundles the e2e suites run against. Every round built
# its own (dist-m, dist-f, dist-r, dist-v, dist-w, dist-y, dist-z...)
# and every round added another line here, and twice a bundle was
# committed because the round's letter had not been added yet. One rule:
# nothing whose name starts dist- belongs in the repository.
dist-*/
