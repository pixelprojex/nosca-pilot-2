# Copy to .env.local for local work, and set the same names in
# Netlify → Site configuration → Environment variables for a deploy.
# Anything starting VITE_ is compiled into the browser bundle, so it
# must be set BEFORE the build and must never hold a secret.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Where "Email support" and "Report a problem" go. Leave unset and
# those rows disappear rather than pointing nowhere.
VITE_SUPPORT_EMAIL=

# The per-file upload limit in MB. Supabase's default is 50; raise this
# only after raising the project's own limit.
VITE_MAX_UPLOAD_MB=50

# Web push, public half. `npx web-push generate-vapid-keys` gives you a
# pair. Without this the app honestly says it cannot send notifications
# rather than asking for permission it can do nothing with.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------
# SERVER SIDE — Netlify environment variables only. These are never
# prefixed VITE_ and must never appear in the bundle:
#   VAPID_PUBLIC_KEY    the same string as VITE_VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY   the private half of the pair
#   VAPID_SUBJECT       mailto:you@example.com
#   PUSH_SECRET         any long random string; the same value goes in
#                       app_settings.push_secret in the database
#   SUPABASE_URL        the project URL again, for the relay
#   SUPABASE_SERVICE_ROLE_KEY   Supabase → Project Settings → API
# ---------------------------------------------------------------
