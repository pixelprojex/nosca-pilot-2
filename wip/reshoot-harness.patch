+/* The plus sheet rising over the coach's day and settling back, for the plus videos. The coach's golf home at rest
+   (rest.png), then the raised plus tapped and every distinct frame of the rise, then the scrim tapped and every
+   frame of the fall, the app's CSS motion slowed tenfold so the bursts sample it finely; each frame is stamped in
+   the animation's own time and motion-encode.py assembles the loop at 30 fps from them, so the timing is the app's.
+   node website/tools/motion.cjs <dist> <port> <rawDir>
+   then: python3 website/tools/motion-encode.py <rawDir> website/assets */
+const path = require("path"), fs = require("fs");
+const L = require("./lib.cjs");
+const [dist, portArg, outDir] = process.argv.slice(2);
+const PORT = Number(portArg || 5856);
+(async () => {
+  const server = await L.serve(dist, PORT);
+  const browser = await L.launch();
+  const { ctx, page, cdp, errors } = await L.boot(browser, L.D.buildDb("golf"), "coach", { port: PORT, scale: 2 });
+  await L.wait(page, 1200);
+  const out = path.resolve(outDir);
+  const F = await L.film(page, cdp, out);
+  fs.writeFileSync(path.join(out, "rest.png"), await page.screenshot({ type: "png" }));
+  await page.locator('[data-tour="quick"]').first().dispatchEvent("click");
+  await F.burst("rise", 9000);
+  /* the scrim over the day, above the sheet */
+  await page.mouse.click(195, 90);
+  await F.burst("fall", 6000);
+  F.save();
+  const e = L.noise(errors); if (e.length) console.log("console:", e.slice(0, 4).join(" | "));
+  await ctx.close(); await browser.close(); server.close(); process.exit(0);
+})().catch((e) => { console.error(e); process.exit(1); });
