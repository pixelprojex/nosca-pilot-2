@@ -0,0 +1,50 @@
+"""motion.cjs's frames -> the plus videos and their posters.
+   python3 website/tools/motion-encode.py <rawDir> <assetsDir>
+The loop is 124 frames at 30 fps (4.13 s) and its last frame is its first: the home at rest (14 frames), the plus
+tapped and the sheet rising, held open (72 frames from the tap), the scrim tapped and the sheet falling, the home at
+rest again (38 frames from the tap). Each frame is what was on the screen at that moment of the app's own animation
+time. Writes:
+  motion-plus-golf.mp4          780 x 1688, H.264, yuv420p, faststart, no sound (plays muted and looped)
+  motion-plus-golf-poster.webp  its first frame
+  seq/plus/plus-scrub.mp4       660 x 1428, a keyframe every second frame, so the scroll can stand it on any frame
+  seq/plus/poster.webp          its first frame
+Needs ffmpeg with libx264."""
+import json, os, shutil, subprocess, sys
+from PIL import Image
+
+FPS, REST_IN, RISE, FALL = 30, 14, 72, 38
+
+def main():
+    raw, assets = sys.argv[1], sys.argv[2]
+    frames = json.load(open(os.path.join(raw, "frames.json")))
+    rise = [f for f in frames if f["seg"] == "rise"]
+    fall = [f for f in frames if f["seg"] == "fall"]
+    if not rise or not fall: raise SystemExit("no rise or fall in frames.json: run motion.cjs first")
+    rest = os.path.join(raw, "rest.png")
+    # what was on the screen at t ms into a burst: the last frame that had arrived by then, else the one before it
+    def at(lst, t, before):
+        on = [f for f in lst if f["at"] <= t]
+        return os.path.join(raw, on[-1]["f"]) if on else before
+    seq = [rest] * REST_IN
+    seq += [at(rise, k * 1000 / FPS, rest) for k in range(RISE)]
+    seq += [at(fall, k * 1000 / FPS, os.path.join(raw, rise[-1]["f"])) for k in range(FALL)]
+    loop = os.path.join(raw, "loop")
+    shutil.rmtree(loop, ignore_errors=True); os.makedirs(loop)
+    for i, f in enumerate(seq): shutil.copyfile(f, os.path.join(loop, "%04d.png" % i))
+    print(len(seq), "frames,", round(len(seq) / FPS, 3), "s; rise frames", len(rise), "over", round(rise[-1]["at"]), "ms; fall", len(fall), "over", round(fall[-1]["at"]), "ms")
+    im = Image.open(rest).convert("RGB")
+    if im.size != (780, 1688): raise SystemExit(f"rest.png is {im.size}, not 780 x 1688 (shot at 2x?)")
+    os.makedirs(os.path.join(assets, "seq", "plus"), exist_ok=True)
+    common = ["-framerate", str(FPS), "-i", os.path.join(loop, "%04d.png"), "-c:v", "libx264", "-preset", "veryslow", "-pix_fmt", "yuv420p", "-movflags", "+faststart", "-an"]
+    def ff(args):
+        subprocess.run(["ffmpeg", "-y", "-loglevel", "error"] + args, check=True)
+    ff(common + ["-crf", "20", os.path.join(assets, "motion-plus-golf.mp4")])
+    ff(common + ["-vf", "scale=660:1428:flags=lanczos", "-crf", "26", "-g", "2", "-keyint_min", "2", "-sc_threshold", "0", "-bf", "0",
+                 os.path.join(assets, "seq", "plus", "plus-scrub.mp4")])
+    im.save(os.path.join(assets, "motion-plus-golf-poster.webp"), "WEBP", quality=86, method=6)
+    im.resize((660, 1428), Image.LANCZOS).save(os.path.join(assets, "seq", "plus", "poster.webp"), "WEBP", quality=72, method=6)
+    for p in ("motion-plus-golf.mp4", "motion-plus-golf-poster.webp", "seq/plus/plus-scrub.mp4", "seq/plus/poster.webp"):
+        print(f"{p:30} {os.path.getsize(os.path.join(assets, p)) / 1024:7.1f} KB")
+
+if __name__ == "__main__":
+    main()
