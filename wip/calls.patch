diff --git a/src/index.css b/src/index.css
index 600bcb8..2d7cbba 100644
--- a/src/index.css
+++ b/src/index.css
@@ -2,6 +2,48 @@
 @tailwind components;
 @tailwind utilities;
 
+/* THE CARD'S SERIF (24 November, the founder's call): the titles — a
+   screen's H1, a section's heading, a sheet's title — are set in
+   Instrument Serif, the face of the business card and the website;
+   everything else is the phone's own face. Two subsets, as the face is
+   published: the Latin one every title needs (preloaded in index.html,
+   so the first screen never swaps faces) and the Latin Extended one,
+   fetched only when a name carries a letter from it — Łukasz, Wiśniewska
+   — so a title is never two faces. Both are hashed into /assets/ by the
+   build, so the service worker keeps them with the shell and a title is
+   the serif on a plane. `block`: while the preloaded file is on its way
+   the title waits for it rather than drawing the system face and
+   swapping; a file that cannot load ends the wait at once and the
+   fallback below takes its place, the same width as the serif, so
+   nothing moves and nothing is cut. Instrument Serif: Copyright 2022
+   The Instrument Serif Project Authors, SIL Open Font License 1.1
+   (src/fonts/OFL-InstrumentSerif.txt; Settings › Licences). */
+@font-face {
+  font-family: "Instrument Serif";
+  src: url(./fonts/InstrumentSerif-Regular.woff2) format("woff2");
+  font-weight: 400;
+  font-style: normal;
+  font-display: block;
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
+}
+@font-face {
+  font-family: "Instrument Serif";
+  src: url(./fonts/InstrumentSerif-Regular-ext.woff2) format("woff2");
+  font-weight: 400;
+  font-style: normal;
+  font-display: block;
+  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
+}
+/* the system's Times sized to the serif's own measure (the website's numbers) */
+@font-face {
+  font-family: "Instrument Serif Fallback";
+  src: local("Times New Roman"), local("TimesNewRomanPSMT"), local("Times");
+  size-adjust: 84.2%;
+  ascent-override: 117.6%;
+  descent-override: 36.8%;
+  line-gap-override: 0%;
+}
+
 * { -webkit-tap-highlight-color: transparent; }
 body { font-family: 'Switzer', ui-sans-serif, system-ui; color: #1A1815; }
 
